# ============================================
# FMOD
# ============================================

# NO ignorar: iconos y gizmos del editor
!/[Aa]ssets/Gizmos/FMOD/*
!/[Aa]ssets/Editor Default Resources/FMOD/*

# NO ignorar: settings compartidos del proyecto
!/[Aa]ssets/Plugins/FMOD/Resources/FMODStudioSettings.asset

# SI ignorar: cache local que se regenera en cada PC
/[Aa]ssets/Plugins/FMOD/Cache/
/[Aa]ssets/Plugins/FMOD/Cache.meta

# SI ignorar: logs locales
fmod_editor.log

# SI ignorar: bancos duplicados en StreamingAssets (ya están en Plugins/FMOD/Banks)
/[Aa]ssets/StreamingAssets/**/*.bank
/[Aa]ssets/StreamingAssets/**/*.bank.meta
